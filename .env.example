# =============================================================================
# business-manager deployment environment
# Copy this file to .env on the server and fill the secrets.
# Never commit the real .env.
# =============================================================================

COMPOSE_PROJECT_NAME=business-manager
BIND_IP=127.0.0.1
EDGE_PORT=8083
DATA_ROOT=/opt/docker-projects-data/business-manager

# Public routing
BASE_DOMAIN=edoutput.dev
TENANT_BASE_DOMAIN=edoutput.dev
RESERVED_SUBDOMAINS=www,tourism-agency,gps-medical-assistance,business-manager

# Runtime / service URLs (Docker DNS names)
POSTGRES_DB_DRIVER=postgres

AUTH_SVC_URL=business-manager-auth-svc
COMPANY_SVC_URL=business-manager-company-svc
CUSTOMER_SVC_URL=business-manager-customer-svc
PRODUCT_SVC_URL=business-manager-product-svc
WHATSAPP_SVC_URL=business-manager-whatsapp-svc
ORDER_SVC_URL=business-manager-order-svc
FILE_SVC_URL=business-manager-file-svc

AUTH_SVC_PORT=50056
COMPANY_SVC_PORT=50053
CUSTOMER_SVC_PORT=50052
PRODUCT_SVC_PORT=50054
WHATSAPP_SVC_PORT=50055
ORDER_SVC_PORT=50057
FILE_SVC_PORT=50058
WHATSAPP_WS_PORT=50059

# Databases
AUTH_SVC_DB=auth-db
AUTH_SVC_DB_USER=postgres
AUTH_SVC_DB_PASSWORD=change-me

COMPANY_SVC_DB=company-db
COMPANY_SVC_DB_USER=postgres
COMPANY_SVC_DB_PASSWORD=change-me

CUSTOMER_SVC_DB=customer-db
CUSTOMER_SVC_DB_USER=postgres
CUSTOMER_SVC_DB_PASSWORD=change-me

ORDER_SVC_DB=order-db
ORDER_SVC_DB_USER=postgres
ORDER_SVC_DB_PASSWORD=change-me

WHATSAPP_SVC_DB=whatsapp-db
WHATSAPP_SVC_DB_USER=postgres
WHATSAPP_SVC_DB_PASSWORD=change-me

PRODUCT_SVC_DB_USER=root
PRODUCT_SVC_DB_PASSWORD=change-me
PRODUCT_DB_NAME=product-db

# Container-internal database URLs
AUTH_DB_SOURCE_DOCKER_CONTAINER=postgresql://postgres:change-me@business-manager-auth-db:5432/auth-db?sslmode=disable
COMPANY_DB_SOURCE_DOCKER_CONTAINER=postgresql://postgres:change-me@business-manager-company-db:5432/company-db?sslmode=disable
CUSTOMER_DB_SOURCE_DOCKER_CONTAINER=postgresql://postgres:change-me@business-manager-customer-db:5432/customer-db?sslmode=disable
ORDER_DB_SOURCE_DOCKER_CONTAINER=postgresql://postgres:change-me@business-manager-order-db:5432/order-db?sslmode=disable
WHATSAPP_DB_SOURCE_DOCKER_CONTAINER=postgresql://postgres:change-me@business-manager-whatsapp-db:5432/whatsapp-db?sslmode=disable
PRODUCT_DB_SOURCE_DOCKER_CONTAINER=mongodb://root:change-me@business-manager-product-db:27017

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY_ID=

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
